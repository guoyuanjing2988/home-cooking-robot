{
  "meta": {
    "created": "2026-10-13",
    "purpose": "Kinematics, joint windows and speed limits of candidate 5-6 kg cobots, so a later sim swap of the UR5e is possible. Companion report: robot_rail/research/r19_arm_hand_cost.md",
    "status": "research data, not a sim model; nothing bought; prices are in the report, all unconfirmed",
    "labels": {
      "M": "manufacturer datasheet / manual / official repo",
      "O": "other source (distributor, marketplace, snippet)",
      "E": "derived or estimated by the R19 hand agent",
      "ND": "not published / not found"
    },
    "units": "lengths m, angles deg unless the key says rad, speeds deg/s unless the key says rad/s, masses kg",
    "dh_convention": "UR-style standard DH (theta, d, a, alpha) as in the UR article; a2/a3 negative as UR publishes them. 'urdf_joint_origins' are copied verbatim from the vendor URDF/xacro; 'dh_ur_style' for non-UR vendors is a mapping by the R19 agent (E) unless marked M.",
    "joint_convention_note": "Range tests assume the candidate uses the UR joint zero/sign convention (FR5 URDF frames follow ur_description's layout; elbow zero = straight for all). Not verified for JAKA, AUBO, Dobot J2/J4.",
    "sim_requirements": {
      "mass_payload_kg_now": 4.15,
      "held_kg_wok_tip": 2.95,
      "max_joint_ratio_ur5e_envelope": 0.629,
      "stir_working_peak_joint_speed_degps_J1_J6": [59, 168, 100, 184, 72, 128],
      "stir_period_formula": "period = 2.4 * max(1, max_j v_j/V_j) * 0.76 + return_s; UR5e: return 0.77 s at 180 deg/s, 360 deg/s^2 trapezoid (assumed accel)",
      "sources": [
        "sim/r10/claude/results/r15/stirwalk2_h_scrape_dice_r17.json",
        "sim/r10/claude/r15stirwalk2.py",
        "sim/r10/claude/results/r17/chain_wok_s-1_final.json"
      ]
    },
    "playback_warning": "The saved results/r17/*.json 'play' arrays contain exact +-360 deg steps between consecutive states (2*pi-equivalent poses) on up to 4 joints per chain. np.unwrap each joint and choose the 2*pi*k offset inside the robot's joint window before sending anything to hardware. Layout of a play row: [carriage_x, base_y, base_yaw, q1..q6, finger_l, finger_r]."
  },
